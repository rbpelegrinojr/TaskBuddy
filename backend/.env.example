# Copy to .env (never commit .env). All values are environment-specific.
APP_ENV=development            # development | production
APP_DEBUG=false                # never true in production
APP_TIMEZONE=UTC

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=taskbuddy
DB_USER=taskbuddy_app
DB_PASS=change-me

# Mobile bearer tokens
TOKEN_TTL_HOURS=168

# Uploads (stored outside the web root)
STORAGE_PATH=../storage
UPLOAD_MAX_BYTES=10485760

# Matching / invitations
INVITATION_TTL_HOURS=72

# Rate limiting: max hits per window (seconds) on sensitive endpoints
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_WINDOW=900

# Name of the PHP session cookie used by the admin dashboard
ADMIN_SESSION_NAME=taskbuddy_admin
